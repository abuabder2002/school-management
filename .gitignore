# Frontend - Node/Vite
school-frontend/node_modules/
school-frontend/dist/
# package-lock.json generated on Windows has corrupted entries for Linux-only optional
# rollup native binaries (missing "version", breaks `npm install` on Vercel/Linux).
# Let each environment generate its own lockfile instead of committing a broken one.
school-frontend/package-lock.json

# Backend - Maven/Java
school-management/**/target/

# Local Maven installation / downloaded archive
school-management/apache-maven-3.9.6/
school-management/maven.zip

# Environment / secrets
.env
.env.*
!.env.example

# IDE files
.vscode/
.idea/
*.iml

# OS files
.DS_Store
Thumbs.db

# Logs
*.log__pycache__/
*.pyc

# AI agent caches
.agents/
.claude/
skills-lock.json

